# Copy to .env (git-ignored) and fill in your own values.
# Used with: flutter run --dart-define-from-file=.env

# Supabase project settings (Project Settings -> API Keys).
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). The legacy SUPABASE_ANON_KEY also works.
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Google Maps SDK for Android key (restricted to this app's package + SHA-1).
MAPS_API_KEY=your-google-maps-android-key
